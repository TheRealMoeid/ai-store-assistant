# --- Telegram ---
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_GROUP_ID=-1001234567890   # chat_id of the group where orders/feedback get posted

# Optional, comma-separated: user_ids allowed to run admin commands from a private DM too
ADMIN_USER_IDS=

# --- LLM provider: "ollama" or "groq" ---
LLM_PROVIDER=ollama

# Used when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Used when LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- History ---
MAX_HISTORY_MESSAGES=20

# --- Network (optional) ---
# Proxy for reaching api.telegram.org when direct connections are blocked.
# Examples: socks5://127.0.0.1:10808   or   http://127.0.0.1:7890
# socks5:// requires: pip install aiohttp-socks
# Leave empty for a direct connection.
PROXY_URL=